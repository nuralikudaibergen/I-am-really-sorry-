# ============================================
# Vercel KV (Recommended) - leave empty to use the Telegram fallback
# Get these from: https://vercel.com/dashboard -> Storage -> KV
# ============================================
KV_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# ============================================
# Admin secret token used for /admin?secret=...
# Use something long and random, e.g.  https://www.random.org/strings
# ============================================
ADMIN_SECRET=""

# ============================================
# Telegram bot fallback (only used if KV is not configured)
# 1) Create a bot with @BotFather on Telegram
# 2) Get the chat_id by messaging @userinfobot
# ============================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
